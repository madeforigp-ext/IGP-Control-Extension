{
  "manifest_version": 3,
  "name": "IGP Control",
  "version": "1.0",
  "description": "ScanRouter + TabGuard + Auto-Login — All in one.",
  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.joinventures.com/*",
        "*://*.indiangiftsportal.com/*"
      ],
      "js": ["qc.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["image-closer.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-protection": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Protect/Unprotect current tab"
    },
    "execute-tabguard": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Close all tabs except protected"
    }
  },
  "action": {
    "default_popup": "popup.html"
  }
}
